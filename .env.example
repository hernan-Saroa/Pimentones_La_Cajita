# Variables de docker compose (producción)
SITE_DOMAIN=www.pimentoneslacajita.com      # dominio para HTTPS automático; "localhost" para pruebas sin TLS
SITE_URL=https://www.pimentoneslacajita.com  # URL pública (metadatos, retorno de Wompi, CORS)
DB_PASSWORD=cambia-esta-clave-larga
TAG=latest
BACKUP_CRON=0 3 * * *
BACKUP_KEEP_DAYS=14
