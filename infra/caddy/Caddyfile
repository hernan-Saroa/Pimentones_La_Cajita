# Proxy de borde: HTTPS automático (Let's Encrypt), compresión y cabeceras. Un solo puerto público.
{$SITE_DOMAIN:localhost} {
	encode zstd gzip

	# API y archivos subidos van a la API; todo lo demás a la web.
	handle /api/* {
		reverse_proxy api:4000
	}
	handle /uploads/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output stdout
		format json
	}
}
